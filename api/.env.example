# Copia este fichero a api/.env para desarrollo local (npm run api lo carga si existe).
# En producción NO hay .env: las variables las inyecta Dokploy en la compose (SPEC §9).

# Sin clave, /api/capacidades devuelve interpretar:false y /api/dieta/interpretar responde 503.
ANTHROPIC_API_KEY=

# Lista blanca: claude-sonnet-5 (por defecto), claude-haiku-4-5, claude-opus-5.
BASCULA_MODELO=claude-sonnet-5

# Topes del día UTC. El de euros es el tope duro.
BASCULA_TOPE_EUROS_DIA=4
BASCULA_TOPE_GLOBAL_DIA=400
BASCULA_TOPE_IP_DIA=40

# Orígenes admitidos, separados por comas.
BASCULA_ORIGENES=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173

# Clave HMAC del token efímero. Vacío = aleatoria en cada arranque (los tokens caducan al reiniciar).
BASCULA_SECRETO=

# Carpeta donde se persisten las cuotas (cuotas.json). En local, algo que exista.
BASCULA_DATOS=./.datos

PORT=8787
